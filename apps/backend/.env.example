# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="cambia-este-secreto-por-uno-seguro"

# Credenciales del administrador (modo mock: login directo sin DB)
ADMIN_EMAIL="admin@predicta.pe"
ADMIN_NAME="Super Admin"
ADMIN_PASSWORD="admin123"

PORT=3001

# ── Base de datos (opcional en modo mock) ─────────────────────────────────────
# Si no se configura DATABASE_URL el backend inicia en modo mock
# usando los datos JSON de src/mocks/data/*.json
# DATABASE_URL="postgresql://postgres:password@localhost:5432/predictape?schema=public"

# ── IA / Agentes (Gemma vía @google/genai) ────────────────────────────────────
# Único proveedor de IA del proyecto: Gemma con el SDK oficial de Google.
# SDK: npm install @google/genai  (ya está en package.json)
# Token de Google AI Studio: https://aistudio.google.com/apikey
#
# Sin GEMINI_API_KEY los endpoints con agentes caen a su fallback (mock),
# el backend NO se rompe. Con token, corren con Gemma.
GEMINI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Modelo Gemma (override global; cada .md puede sobreescribirlo en su frontmatter):
LLM_MODEL="gemma-4-31b-it"

# Extras opcionales (Gemma normalmente NO los soporta; déjalos en false):
# GEMINI_USE_SEARCH="false"
# GEMINI_THINKING="false"

# Carpeta con los .md de agentes que corren (por defecto <cwd>/agents):
# AGENTS_DIR="./agents"

# ── Datos / CSVs ──────────────────────────────────────────────────────────────
# Carpetas para CSVs y datos de entrada (por defecto <cwd>/data y subcarpetas):
# DATA_DIR="./data"
# CSV_DIR="./data/csv"
# UPLOADS_DIR="./data/uploads"
