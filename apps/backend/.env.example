DATABASE_URL="postgresql://postgres:password@localhost:5432/predictape?schema=public"
PORT=3001

# ── LLM / AI ──────────────────────────────────────────────────────────────────
# Proveedor por defecto: Groq (compatible con OpenAI SDK)
# Obtén tu API key en https://console.groq.com
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# URL base del proveedor (Groq, OpenAI, o cualquier compatible)
LLM_BASE_URL="https://api.groq.com/openai/v1"

# Modelo a usar. Opciones Groq: gemma2-9b-it | llama-3.1-8b-instant | llama3-70b-8192
# Para OpenAI: gpt-4o-mini | gpt-4o
LLM_MODEL="gemma2-9b-it"
