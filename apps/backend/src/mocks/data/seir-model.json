  "_contract": {
    "source": "Predicta AI Engine — Modelo Dengue Determinista",
    "description": "Proyección epidémica semanal basada en modelo SEIR con vector (dengue/malaria). Calibrado con brote El Niño Yaku 2023-2024 en Piura. Parámetros climáticos de SENAMHI, datos hospitalarios de MINSA.",
    "endpoint": "POST https://api.predicta.pe/v1/riesgo/seir-model",
    "auth": "Bearer token interno",
    "request_schema": {
      "region": "string — departamento o 'departamento — ciudad'",
      "ventana_semanas": "number — 12 o 16",
      "parametros": {
        "anomalia_lluvias_pct": "number — porcentaje sobre la media histórica SENAMHI (-50 a 500)",
        "anomalia_temperatura_c": "number — anomalía térmica en °C (-3 a 5)",
        "enos_intensidad": "'neutro' | 'moderado' | 'fuerte'",
        "racionamiento_agua_pct": "number — % de hogares almacenando agua en contenedores (0-100)",
        "eficiencia_control_vectorial_pct": "number — cobertura de fumigación/abatización (0-100)",
        "desabastecimiento_insumos_pct": "number — % de insumos faltantes (0-100)",
        "serotipo_dominante": "'DEN-1' | 'DEN-2' | 'DEN-3' | 'DEN-4'"
      }
    },
    "notes": "Los 3 presets (optimista/moderado/critico) mapean a enos_intensidad (neutro/moderado/fuerte). El modelo ajusta R0 y parámetros de transmisión según las anomalías climáticas."
  },

