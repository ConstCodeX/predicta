# ──────────────────────────────────────────────────────────────────────────────
# Predicta AI — Variables de entorno de producción
#
# Uso:
#   cp .env.example .env
#   nano .env          ← rellena los valores reales
#
# NUNCA commitees .env al repositorio. Solo .env.example va al control de
# versiones. Asegúrate de que .gitignore incluya ".env".
#
# En Dokploy puedes gestionar estas variables directamente desde la UI del
# proyecto, sin necesitar un archivo .env en el servidor.
# ──────────────────────────────────────────────────────────────────────────────

# ── Dominio (Traefik / Dokploy) ──────────────────────────────────────────────
# El dominio por el que será accesible la app. Puede ser:
#   - Tu subdominio de Dokploy:  predictape.tuservidor.com
#   - Tu propio dominio:         app.predictape.pe
DOMAIN=predictape.tuservidor.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=predictape
POSTGRES_USER=postgres

# Genera una contraseña segura:
#   openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASEÑA_EN_PRODUCCION

# ── Autenticación JWT ────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens JWT. Genera una con:
#   openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTA_CLAVE_JWT_EN_PRODUCCION

# Superadmin seedeado automáticamente al arrancar (se crea en BD si no existe)
ADMIN_EMAIL=victorlarcob@gmail.com
ADMIN_NAME=Victor Larco
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASEÑA_EN_PRODUCCION

# ── LLM / Google AI Studio (Gemma) ───────────────────────────────────────────
# Obtén tu API key gratuita en: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Activa Google Search grounding (solo modelos que la soporten):
GEMINI_USE_SEARCH=false

# Activa thinking (razonamiento extendido, solo modelos que lo soporten):
GEMINI_THINKING=false
