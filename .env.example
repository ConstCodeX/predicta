# ──────────────────────────────────────────────────────────────────────────────
# Predicta AI — Variables de entorno de producción
#
# Uso:
#   cp .env.example .env
#   nano .env          ← rellena los valores reales
#
# NUNCA commitees .env al repositorio. Solo .env.example va al control de
# versiones. Asegúrate de que .gitignore incluya ".env".
#
# En Dokploy puedes gestionar estas variables directamente desde la UI del
# proyecto, sin necesitar un archivo .env en el servidor.
# ──────────────────────────────────────────────────────────────────────────────

# ── Dominio (Traefik / Dokploy) ──────────────────────────────────────────────
# El dominio por el que será accesible la app. Puede ser:
#   - Tu subdominio de Dokploy:  predictape.tuservidor.com
#   - Tu propio dominio:         app.predictape.pe
DOMAIN=predictape.tuservidor.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=predictape
POSTGRES_USER=postgres

# Genera una contraseña segura:
#   openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASEÑA_EN_PRODUCCION

# ── LLM / Groq ───────────────────────────────────────────────────────────────
# Obtén tu API key gratuita en: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL base del proveedor (compatible con OpenAI SDK)
# Groq (defecto):  https://api.groq.com/openai/v1
# OpenAI:          https://api.openai.com/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Modelo a usar
# Groq gratuito:  gemma2-9b-it | llama-3.1-8b-instant | llama3-70b-8192
# OpenAI:         gpt-4o-mini  | gpt-4o
LLM_MODEL=gemma2-9b-it
